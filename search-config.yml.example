# Semantic Search Service Configuration
# Copy to search-config.yml and customize as needed.

# Feature flags
features:
  indexing: true
  search: true
  auto_tags: false    # "false" | "manual" | "on_index" (requires llm.provider != "disabled")
  summaries: false    # "false" | "manual" | "on_index" (requires llm.provider != "disabled")
  # rag: false        # future

# LLM provider configuration (required for auto_tags and future LLM features)
# Supports any OpenAI-compatible API: ollama, vLLM, LM Studio, OpenAI, DeepSeek, etc.
# Note: File content (transcripts, captions, text) is sent to the LLM API.
# For privacy-sensitive content, use a local LLM (e.g., ollama).
llm:
  provider: "disabled"       # "openai_compatible" | "disabled"
  base_url: ""               # e.g. "http://host.docker.internal:11434/v1" (ollama)
  api_key: ""                # or use env var LLM_API_KEY
  model: ""                  # e.g. "gemma2:9b", "gpt-4o-mini", "deepseek-chat"
  max_tokens: 2048
  temperature: 0.3
  output_language: "auto"    # "auto" | "ja" | "en" — applies to auto_tags and summaries
  # Retry behavior for transient failures (timeouts, 429, 5xx)
  retry_attempts: 3          # total attempts = 1 + retries
  retry_base_delay: 1.0      # seconds; doubled on each retry
  retry_max_delay: 30.0      # cap on individual backoff delay
  # Rate limiting: minimum interval between requests (0 = no limit)
  # Useful for external APIs with strict rate limits. For local ollama, leave at 0.
  min_request_interval_ms: 0
  # Example: ollama with auto_tags
  # provider: "openai_compatible"
  # base_url: "http://host.docker.internal:11434/v1"
  # model: "gemma2:9b"
  # Example: DeepSeek API
  # provider: "openai_compatible"
  # base_url: "https://api.deepseek.com/v1"
  # model: "deepseek-chat"

# AI Summaries configuration (used when features.summaries != "false")
# Generates 1-sentence short summary + paragraph long summary for videos,
# audio files, and documents. Display-only: never writes to HomeVault DB.
summaries:
  min_context_chars: 50      # skip files with less usable content than this
                             # (prevents hallucinated summaries from near-empty transcripts)
  max_context_chars: 8000    # threshold: smaller contexts are sent in full
  window_chars: 2500         # per-window size when sampling long content
  window_count: 3            # number of windows (first/middle/last; use odd numbers)

models:
  # Whisper model for audio transcription (multilingual)
  whisper: "openai/whisper-small"

  # Text embedding model (multilingual, used for metadata + transcript)
  text_embedding: "intfloat/multilingual-e5-small"

  # CLIP model for image/video frame analysis
  # Swap for language-specific models:
  #   Japanese: rinna/japanese-clip-vit-b-16
  #   Chinese:  OFA-Sys/chinese-clip-vit-base-patch16
  #   Multi:    M-CLIP/XLM-Roberta-Large-Vit-B-32 (~1.5GB)
  clip: "openai/clip-vit-b-32"

  # BLIP model for image captioning (optional, used by auto_tags)
  # Generates English text descriptions of images for tag generation.
  # Leave empty to disable. Requires ~1GB additional memory.
  # blip: "Salesforce/blip-image-captioning-base"
  blip: ""
  # BLIP caption generation parameters:
  # blip_max_tokens: max output length (default: 50, increase for longer captions)
  # blip_num_beams: beam search width (default: 1 = greedy, 3-4 = better quality but slower)
  # blip_max_tokens: 100
  # blip_num_beams: 3

# Search parameters
search:
  # Weight for vector similarity vs keyword matching
  # 0.0 = keyword only, 1.0 = vector only
  alpha: 0.7

  # Default result limit
  default_limit: 20
  max_limit: 100

# Indexing parameters
indexing:
  # Reconciliation interval with HomeVault DB (seconds)
  reconciliation_interval: 3600

  # Frame extraction settings for video CLIP analysis
  frame_extraction:
    # Scene detection threshold (0.0-1.0, higher = fewer frames)
    scene_threshold: 0.3
    # Minimum interval between frames (seconds)
    min_interval: 30
    # Maximum frames per video
    max_frames: 500

  # Whisper transcription settings
  whisper:
    # Segment duration range (seconds)
    min_segment_duration: 30
    max_segment_duration: 60
    # Beam size (1 = greedy decoding, faster; 5 = beam search, slightly more accurate)
    beam_size: 1
    # Batch size for parallel inference (0 = sequential, >0 = batched with VAD)
    batch_size: 16
    # Use previous segment text as context (false = faster, less hallucination)
    condition_on_previous_text: false

  # Text chunking settings
  text_chunking:
    # Maximum characters per chunk
    max_chunk_size: 1000
    # Overlap between chunks
    overlap: 200

# Worker concurrency
workers:
  whisper_parallel: 1
  clip_parallel: 2
  metadata_batch_size: 32
  clip_frame_batch_size: 50

# Model memory management
# Whisper and BLIP are only used during indexing, so they can be
# unloaded after a period of inactivity to free RAM (~500MB each).
# CLIP and text_embedding stay resident because they are used by
# the search query path on every request.
memory:
  # Unload Whisper model after idle (seconds, 0 = never unload)
  whisper_idle_unload: 300
  # Unload BLIP model after idle (seconds, 0 = never unload)
  blip_idle_unload: 300
