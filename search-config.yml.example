# Semantic Search Service Configuration
# Copy to search-config.yml and customize as needed.

# Feature flags
features:
  indexing: true
  search: true
  auto_tags: false    # "false" | "manual" | "on_index" (requires llm.provider != "disabled")
  summaries: false    # "false" | "manual" | "on_index" (requires llm.provider != "disabled")
  detailed_summaries: false
                      # "false" | "manual" | "on_index" — long-form Markdown summary.
                      # - "manual":   generated on user request
                      # - "on_index": generated automatically after each indexing
                      #               pass. Token usage scales linearly with new
                      #               files per day: roughly 10K-15K input tokens
                      #               and 1.5K-3K output tokens per file (depends
                      #               on content length and tokenizer). Estimate
                      #               your own cost from your provider's pricing
                      #               before enabling. A patient local LLM avoids
                      #               API cost entirely at the expense of runtime.
                      # Independent of "summaries": may be enabled alone.
                      # Requires llm.provider != "disabled".
  rag: false          # true | false — question answering (requires llm.provider != "disabled")
                      # SECURITY: when enabled, file content (transcripts, captions,
                      # text) is sent to the LLM API on every ask. For privacy-sensitive
                      # content use a local LLM (e.g., ollama).
  transcript_refine: false
                      # "false" | "manual" | "on_index" — LLM-based ASR transcript
                      # correction. Originals kept in text_original for revert.
                      # Requires llm.provider != "disabled".

# LLM provider configuration (required for auto_tags and future LLM features)
# Supported providers:
#   "ollama"            — ollama's native /api/chat API. Sends think: false so
#                         reasoning models (Gemma 4, DeepSeek-R1, QwQ) skip
#                         chain-of-thought and respond immediately. Use this
#                         for any ollama instance, even non-reasoning models.
#   "openai_compatible" — OpenAI SDK. Works with OpenAI, DeepSeek, vLLM,
#                         LM Studio, etc. Also works with ollama, but thinking
#                         cannot be disabled over this API.
#   "disabled"          — no LLM features.
# Note: File content (transcripts, captions, text) is sent to the LLM API.
# For privacy-sensitive content, use a local LLM (e.g., ollama).
llm:
  provider: "disabled"       # "ollama" | "openai_compatible" | "disabled"
  base_url: ""               # ollama: "http://host.docker.internal:11434"
                             # openai_compatible: "http://host.docker.internal:11434/v1"
  api_key: ""                # or use env var LLM_API_KEY (ignored for ollama)
  model: ""                  # e.g. "gemma4:e4b", "gpt-4o-mini", "deepseek-chat"
  max_tokens: 2048
  temperature: 0.3
  output_language: "auto"    # "auto" | "ja" | "en" — applies to auto_tags and summaries
  # Retry behavior for transient failures (timeouts, 429, 5xx)
  retry_attempts: 3          # total attempts = 1 + retries
  retry_base_delay: 1.0      # seconds; doubled on each retry
  retry_max_delay: 30.0      # cap on individual backoff delay
  # Rate limiting: minimum interval between requests (0 = no limit)
  # Useful for external APIs with strict rate limits. For local ollama, leave at 0.
  # For RAG with external APIs, consider 500-1000 ms to limit cost per user click.
  min_request_interval_ms: 0
  # Hard per-request timeout. Default 90s is generous for local ollama on
  # mid-range hardware; remote APIs rarely take more than 30s. If your ollama
  # runs on slow hardware, raise; if you want faster failure on remote stalls,
  # lower. The host addon proxy times the browser side out at 15s anyway.
  request_timeout_seconds: 90.0
  request_connect_timeout_seconds: 10.0
  # Example: ollama (preferred — supports think: false for reasoning models)
  # provider: "ollama"
  # base_url: "http://host.docker.internal:11434"
  # model: "gemma4:e4b"
  # Example: DeepSeek API
  # provider: "openai_compatible"
  # base_url: "https://api.deepseek.com/v1"
  # model: "deepseek-chat"

# AI Summaries configuration (used when features.summaries != "false")
# Generates 1-sentence short summary + paragraph long summary for videos,
# audio files, and documents. Display-only: never writes to HomeVault DB.
summaries:
  min_context_chars: 50      # skip files with less usable content than this
                             # (prevents hallucinated summaries from near-empty transcripts)
  max_context_chars: 8000    # short/long path: full text up to this length,
                             # otherwise sample windows
  window_chars: 2500         # per-window size when sampling long content
  window_count: 3            # number of windows for the short/long path
                             # (first/middle/last; use odd numbers)
  # Detailed (Markdown long-form) summary uses its own threshold so the
  # "重要ポイントまとめ" table has broad coverage. Generation is manual /
  # on-demand so extra prefill cost is acceptable. Raise carefully on
  # local LLMs with small context windows (e.g. 8K-32K models).
  detailed_max_context_chars: 24000
  detailed_window_count: 5   # fallback window count when detailed context
                             # exceeds the threshold above
  # Citation linking for detailed summaries.
  # After generation (and after every edit/revert) each bullet/paragraph
  # is embedded and matched against transcript/document chunks of the
  # same file. Segments whose top-1 cosine similarity is below
  # ``citation_threshold`` are surfaced in the UI as "no strong source"
  # (⚠), which doubles as a hallucination signal.
  # Tune up if too many ⚠ warnings appear on obviously-grounded bullets,
  # down if hallucinated bullets are slipping through without a warning.
  citation_threshold: 0.55   # cosine similarity floor for has_citation=true
  citation_top_k: 3          # number of candidate chunks stored per segment
                             # (UI can cycle through them; top-1 drives ⚠)
  # Hybrid retrieval: reranks dense-KNN candidates with BM25 over the
  # FTS5 mirrors so numeric values and proper nouns (e.g. "3 日",
  # "京都") aren't drowned out by the dominant noun when the segment
  # is a table row or a general-topic bullet. Dense cosine is still
  # used as the stored ``top_score`` so ``citation_threshold`` keeps
  # its documented meaning.
  # Disable (set to false) if you see BM25 introducing lexically-close
  # but semantically-wrong hits on a specific corpus; this restores
  # the legacy dense-only behaviour.
  citation_hybrid_enabled: true
  # Candidate pool size used by hybrid retrieval. Dense KNN pulls this
  # many candidates; BM25 only reorders within the pool (never adds
  # outside candidates, so cosine-based ``top_score`` stays intact).
  # Must be >= ``citation_top_k``.
  citation_top_k_internal: 10
  # RRF fusion constant. 60 is the canonical IR value; lower numbers
  # amplify the weight of top-ranked candidates.
  citation_rrf_k: 60
  # Section anchoring: for every prefix of a segment's ancestor_headings
  # chain (H2, H2+H3, ...), pool the embeddings of all segments under
  # that prefix and find the transcript chunk range where that pool's
  # content is discussed. Each prefix is resolved independently
  # against the full file — a parent prefix does NOT constrain its
  # children. This keeps structural parents like "## 詳細内容"
  # (a container that holds unrelated H3 recipe sections) from
  # dragging every child into whatever zone their average pool
  # happens to score on. Segments look up the deepest prefix's range
  # only; prefixes don't inherit from each other. Disable to revert
  # to full-file retrieval for every segment.
  citation_section_anchor_enabled: true
  # Top-M chunks whose cosine clears ``citation_section_narrow_threshold``
  # define the range at each hierarchy level. Raise M to tolerate
  # spread topics (wider range); lower M insists on tighter focus.
  citation_section_range_top_m: 12
  # Score floor for continuing to narrow AND for keeping a chunk in
  # the range. When no chunk at the current level clears this cosine,
  # narrowing stops and the prefix inherits its parent's range.
  # 0.5 is a moderate default; lower it if useful sections start
  # getting ignored on loose-match summaries.
  citation_section_narrow_threshold: 0.5
  # Dense-cluster detection: after picking the top-M scoring chunks,
  # split them into contiguous clusters by chunk_index gap. A gap of
  # more than this many positions starts a new cluster. The largest
  # cluster (by total score) defines the section's range so a few
  # high-scoring outliers on the far side of the file don't widen
  # the range to span the whole video. Increase on long files where
  # legitimate topics span wider stretches.
  citation_section_cluster_gap: 5
  # Union the runner-up cluster with the primary when its total
  # score is this fraction of the primary's or higher. Catches
  # sections that legitimately reference two parts of the video
  # (e.g. a 結論 revisiting both intro and outro). 0.8 is
  # conservative — only near-tied runners-up get unioned.
  citation_section_cluster_union_ratio: 0.8
  # Discriminative scoring: for each section, compute per-chunk
  # cosine against its pool AND against every sibling section's
  # pool, then use (this_cos - max_sibling_cos) for ranking and
  # filtering. This handles the "whole video shares one topic"
  # case (e.g. a recipe video where every chunk is about cooking):
  # absolute cosine can't tell sibling recipes apart, but the
  # relative edge over the best sibling can. Disable (false) for
  # corpora where sibling pools are known to be noisy or where
  # strict relative ranking causes legitimate cross-cuts to drop.
  citation_section_discriminative_enabled: true
  # Minimum margin a chunk needs over its best-sibling cosine to be
  # kept in the range. 0.01 catches clear outliers while tolerating
  # minor noise; raise for stricter section boundaries.
  citation_section_disc_margin: 0.01
  # Monotonic DP alignment: for sibling section groups (2+ prefixes
  # sharing a parent), assign each chunk to exactly one section via
  # a Viterbi pass that forbids going backward through the summary's
  # section order. Formalises "summary sections appear in source
  # order" and fixes cases where a section's pool matches broadly
  # across the video. Falls back to pool + cluster detection when
  # a prefix has fewer than 2 siblings or alignment is disabled.
  citation_section_alignment_enabled: true
  # Boundary smoothing: DP's strict 1:1 assignment creates hard
  # borders; a "transition chunk" that legitimately serves two
  # sections falls on one side only. Expanding each section's
  # DP-assigned range by this many chunks on each side restores
  # overlap at the borders. 2 is gentle; 0 disables smoothing.
  citation_section_boundary_margin: 2
  # Margin gate: when top-1 - top-2 is smaller than this cosine gap,
  # flip has_citation to False because the pick is low-confidence
  # (several candidates look comparably close). Reduces "misleadingly
  # confident" citations on abstract bullets and on table rows whose
  # content spans multiple transcript chunks (no single chunk really
  # matches). 0 disables the gate and restores the pre-gate behaviour.
  citation_margin_gate: 0.05
  # Bypass threshold: top-1 scores at or above this value skip the
  # margin gate. When the leader is already strongly matched, a close
  # runner-up usually means the segment has multiple legitimate
  # sources — not uncertainty.
  citation_margin_bypass_score: 0.75
  # Compound-bullet multi-anchor retrieval. Splits a bullet on CJK
  # punctuation (、。・，) when each fragment carries its own salient
  # tokens, then runs retrieval per sub-segment and unions the
  # results. Handles bullets that summarise several sub-facts / sub-
  # steps in one line — a compound anchor where top-1 would otherwise
  # be under-determined. Leaves table rows (cells) and paragraphs
  # alone; 0 or 1 usable sub-segment falls back to the legacy single-
  # embedding path. Disable to restore the legacy behaviour (e.g. to
  # A/B the delta in an ablation).
  citation_multi_anchor_enabled: true
  # Minimum character length for a sub-segment to be kept when a
  # compound bullet is split. Shorter fragments (particles, single
  # nouns like "水分") over-match; dropping them means the parent
  # bullet's full text stays the sole anchor for that fragment's
  # content, which is safer than retrieving with an impoverished query.
  citation_multi_anchor_min_len: 4

# RAG (question answering) configuration (used when features.rag = true)
# Retrieves top-k files for a user question, builds a bounded context
# excerpt per file, and asks the LLM to produce an answer with citations.
# Nothing is persisted: every ask is a one-shot retrieval + generation.
rag:
  top_k: 5                          # files retrieved and fed to the LLM
  max_context_chars_per_file: 2000  # per-file budget for the context excerpt
  max_total_context_chars: 10000    # hard cap on combined context size
  max_tokens: 1024                  # LLM max_tokens override for answer generation
  transcript_window_seconds: 30.0   # context window around each timestamped match

models:
  # Whisper model for audio transcription (multilingual)
  # Default: openai/whisper-small (244M, ~500MB int8 RAM)
  # Alternatives (multilingual, CT2 int8):
  #   openai/whisper-large-v3-turbo  (809M, ~1.0-1.2GB RAM; best accuracy/speed balance)
  #   openai/whisper-large-v3        (1550M, ~2-3GB RAM; highest accuracy)
  # Any faster-whisper size string or CT2-compatible HuggingFace repo ID
  # is also accepted verbatim (e.g. "deepdml/faster-whisper-large-v3-turbo-ct2").
  # Raise memory.whisper_idle_unload cost: larger models evict slower if you
  # keep the default 300s.
  whisper: "openai/whisper-small"

  # Text embedding model (multilingual, used for metadata + transcript)
  text_embedding: "intfloat/multilingual-e5-small"

  # CLIP model for image/video frame analysis
  # Swap for language-specific models:
  #   Japanese: rinna/japanese-clip-vit-b-16
  #   Chinese:  OFA-Sys/chinese-clip-vit-base-patch16
  #   Multi:    M-CLIP/XLM-Roberta-Large-Vit-B-32 (~1.5GB)
  clip: "openai/clip-vit-b-32"

  # BLIP model for image captioning (optional, used by auto_tags)
  # Generates English text descriptions of images for tag generation.
  # Leave empty to disable. Requires ~1GB additional memory.
  # blip: "Salesforce/blip-image-captioning-base"
  blip: ""
  # BLIP caption generation parameters:
  # blip_max_tokens: max output length (default: 50, increase for longer captions)
  # blip_num_beams: beam search width (default: 1 = greedy, 3-4 = better quality but slower)
  # blip_max_tokens: 100
  # blip_num_beams: 3

# Search parameters
search:
  # Weight for vector similarity vs keyword matching
  # 0.0 = keyword only, 1.0 = vector only
  alpha: 0.7

  # Default result limit
  default_limit: 20
  max_limit: 100

# Indexing parameters
indexing:
  # Reconciliation interval with HomeVault DB (seconds)
  reconciliation_interval: 3600

  # Frame extraction settings for video CLIP analysis
  frame_extraction:
    # Scene detection threshold (0.0-1.0, higher = fewer frames)
    scene_threshold: 0.3
    # Minimum interval between frames (seconds)
    min_interval: 30
    # Maximum frames per video
    max_frames: 500

  # Whisper transcription settings
  whisper:
    # Segment duration range (seconds)
    min_segment_duration: 30
    max_segment_duration: 60
    # Beam size (1 = greedy decoding, faster; 5 = beam search, slightly more accurate)
    beam_size: 1
    # Batch size for parallel inference (0 = sequential, >0 = batched with VAD).
    # Sequential mode (0) is recommended: batched mode's VAD can drop speech
    # segments in videos with BGM, and compression_ratio_threshold is less
    # effective per-VAD-chunk. Trade-off: ~2x slower than batched.
    batch_size: 0
    # Use previous segment text as context for the next segment.
    # Propagates punctuation style from initial_prompt across the full
    # transcript. Safe when compression_ratio_threshold guards against
    # hallucination loops.
    condition_on_previous_text: true
    # Compression ratio threshold: segments above this are discarded as
    # repetitive (looping hallucinations). Lower = stricter. 0 = disabled.
    # faster-whisper default is 2.4; 2.0 is recommended to catch chanting/BGM loops.
    compression_ratio_threshold: 2.0
    # No-speech threshold: segments with no-speech probability above this
    # are discarded. Default 0.6 is too aggressive for videos with BGM;
    # 0.45 keeps more speech. 0 = disabled.
    no_speech_threshold: 0.45
    # Log probability threshold: segments with average log prob below this
    # are discarded as low-confidence. -1.0 is lenient. 0 = disabled.
    log_prob_threshold: -1.0
    # Short example sentence fed to the Whisper decoder to bias its style,
    # primarily for punctuation insertion in languages that often omit it
    # (Japanese, Chinese). Keep under ~1-2 sentences; longer prompts waste
    # the 224-token context window and can drift the output topic.
    # DO NOT include filenames, titles, or proper noun lists here —
    # Whisper will latch onto unrelated words and hallucinate them into
    # the transcript. Use a curated glossary layer for vocabulary hints.
    # Example (Japanese): "こんにちは、今日は良い天気ですね。では、本題に入りましょう。"
    # Example (English):  "Hello, everyone. Today, we will cover a short introduction."
    initial_prompt: ""

  # Text chunking settings
  text_chunking:
    # Maximum characters per chunk
    max_chunk_size: 1000
    # Overlap between chunks
    overlap: 200

# Worker concurrency
workers:
  whisper_parallel: 1
  clip_parallel: 2
  metadata_batch_size: 32
  clip_frame_batch_size: 50

# Model memory management
# Whisper and BLIP are only used during indexing, so they can be
# unloaded after a period of inactivity to free RAM (~500MB each).
# CLIP and text_embedding stay resident because they are used by
# the search query path on every request.
memory:
  # Unload Whisper model after idle (seconds, 0 = never unload)
  # Lower this (e.g. 60-120) if you run a local LLM alongside intelligence
  # and want Whisper to release RAM sooner between indexing bursts.
  whisper_idle_unload: 300
  # Unload BLIP model after idle (seconds, 0 = never unload)
  blip_idle_unload: 300
